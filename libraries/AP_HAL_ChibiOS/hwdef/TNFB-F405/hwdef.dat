# hw definition file for processing by chibios_hwdef.py
# Custom flight controller board, based on STM32F405RGT6 (LQFP64)
#
# VARSAYIMLAR:
#  - PA5-PA7 (SPI1) kullanılmıyor / boşta bırakıldı
#  - PA8 PWM ToneAlarm Buzzer için kullanılıyor (TIM1)
#  - PA4 ve PC4 Kullanıcı LED'leri (LED A ve LED B)
#  - UART4 = ESC Telemetry (RX hattı), USART1 = Telem1, USART3 = GPS1,
#    USART2 = Telem2 (varsayılan) VEYA seri RC girişi (BRD_ALT_CONFIG=1 ile)
#  - Sensörler I2C1 hattına bağlı: ICM42670 (0x69), BMP581 (0x47), MMC5983MA (0x30)

#################################################
###             MCU CONFIGURATION             ###
#################################################

MCU STM32F4xx STM32F405xx

# board ID. Bkz. Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_TNFB_F405

# harici ana kristal: 24 MHz (PH0/PH1)
OSCILLATOR_HZ 24000000

# sistem tick timer için, PWM/RCin için kullanmadığımız bir zamanlayıcı seçiyoruz
define STM32_ST_USE_TIMER 4
define CH_CFG_ST_RESOLUTION 16

# STM32F405RGT6 = 1MB flash
FLASH_SIZE_KB 1024

# bootloader için ayrılan alan
FLASH_RESERVE_START_KB 48

#################################################
###             I2C - SENSOR BUS              ###
#################################################

# Tüm sensörler I2C1 üzerinde (Bus Index: 0)
I2C_ORDER I2C1

PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

#################################################
###             SERIAL PORTS                  ###
#################################################
# SERIAL0 = USB (console/MAVLink)
# SERIAL1 = USART1 -> Telem1
# SERIAL2 = USART2 -> Telem2 (varsayılan) / RC giriş (BRD_ALT_CONFIG=1)
# SERIAL3 = USART3 -> GPS1
# SERIAL4 = UART4  -> ESC Telemetry
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# SWD (programlama/debug)
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# USART1 - Telem1
PA9  USART1_TX USART1
PA10 USART1_RX USART1

# USART2 - Telem2 (varsayılan davranış)
PA2 USART2_TX USART2
PA3 USART2_RX USART2 NODMA

# USART3 - GPS1
PB10 USART3_TX USART3
PB11 USART3_RX USART3

# UART4 - ESC Telemetry (tek yönlü, sadece RX)
PA0 UART4_TX UART4
PA1 UART4_RX UART4

#################################################
###             CAN BUS (CAN1 + CAN2)         ###
#################################################

PB8  CAN1_RX CAN1
PB9  CAN1_TX CAN1

PB12 CAN2_RX CAN2
PB13 CAN2_TX CAN2

#################################################
###             SDIO - MicroSD (SD Card)      ###
#################################################

PC8  SDIO_D0  SDIO
PC9  SDIO_D1  SDIO
PC10 SDIO_D2  SDIO
PC11 SDIO_D3  SDIO
PC12 SDIO_CK  SDIO
PD2  SDIO_CMD SDIO

# FAT dosya sistemi ile SD karta loglama
define HAL_OS_FATFS_IO 1

#################################################
###             SPI1 - BOŞTA / SPARE          ###
#################################################
# PA5-PA7 şu an hiçbir cihaza bağlı değil. PA4 LED olarak tanımlandı.

#################################################
###             ANALOG (BATTERY / 5V SENSE)   ###
#################################################

PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC1 BATT_CURRENT_SENS ADC1 SCALE(1)
PC2 VDD_5V_SENS        ADC1 SCALE(2)

# PC0 = ADC1_IN10, PC1 = ADC1_IN11, PC2 = ADC1_IN12
define HAL_BATT_VOLT_PIN 10
define HAL_BATT_CURR_PIN 11

define HAL_BATT_VOLT_SCALE 11.0
define HAL_BATT_CURR_SCALE 17.0

#################################################
###             PWM / MOTOR ÇIKIŞLARI         ###
#################################################

PA15 TIM2_CH1  TIM2  PWM(1) GPIO(50)
PB0  TIM3_CH3  TIM3  PWM(2) GPIO(51)
PB4  TIM3_CH1  TIM3  PWM(3) GPIO(52)
PB5  TIM3_CH2  TIM3  PWM(4) GPIO(53)
PB14 TIM12_CH1 TIM12 PWM(5) GPIO(54) NODMA
PB15 TIM12_CH2 TIM12 PWM(6) GPIO(55) NODMA

#################################################
###             BUZZER (PWM / TONE ALARM)     ###
#################################################
# 4kHz Pasif Buzzer (Samesky vb.) için PWM tabanlı ses üretimi
PA8 TIM1_CH1 TIM1 ALARM

#################################################
###             USER LEDS                     ###
#################################################
# LEDleri OUTPUT ve başlangıçta LOW olacak şekilde tanımlıyoruz
PA4 LED0 OUTPUT LOW GPIO(90)
PC4 LED1 OUTPUT LOW GPIO(91)

# ArduPilot durum (bildirim) LED'leri ile eşleştiriyoruz
define HAL_GPIO_A_LED_PIN 90
define HAL_GPIO_B_LED_PIN 91

# LED'lerin Active-High çalıştığını varsayıyoruz. 
# (Eğer LED'leri GND'ye çekerek yakıyorsanız ON 0, OFF 1 yapın)
define HAL_GPIO_LED_ON 1

#################################################
###             IMU / COMPASS / BARO          ###
#################################################

# IMU: ICM42670 (I2C1 üzerinde, adres 0x69)
IMU Invensensev3 I2C:0:0x69 ROTATION_ROLL_180_YAW_270
define HAL_DEFAULT_INS_FAST_SAMPLE 1

# BARO: BMP581 (I2C1 üzerinde, adres 0x47)
BARO BMP581 I2C:0:0x47

# COMPASS: MMC5983MA (I2C1 üzerinde, adres 0x30)
COMPASS MMC5XX3 I2C:0:0x30 false ROTATION_NONE

define AP_COMPASS_PROBING_ENABLED 1
define ALLOW_ARM_NO_COMPASS

#################################################
###             STORAGE (FRAM YOK)            ###
#################################################

STORAGE_FLASH_PAGE 1
define HAL_STORAGE_SIZE 15360

#################################################
###             OSD & EXTRAS                  ###
#################################################
include ../include/minimize_fpv_osd.inc

undef AP_BARO_BMP581_ENABLED
define AP_BARO_BMP581_ENABLED 1

undef AP_INS_ICM42670_ENABLED
define AP_INS_ICM42670_ENABLED 1

undef AP_COMPASS_MMC5XX3_ENABLED
define AP_COMPASS_MMC5XX3_ENABLED 1